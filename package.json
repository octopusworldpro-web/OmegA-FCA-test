{
  "name": "@nirzon-islam/omega-fca",
  "version": "0.2.2",
  "description": "OmegA-FCA — unofficial Facebook Messenger client and FCA compatibility layer",
  "main": "dist/cjs.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/cjs.cjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/",
    "docs/",
    "README.md",
    "test/",
    "LICENSE",
    "NOTICE",
    "fca-config.example.json"
  ],
  "scripts": {
    "test": "npm run build && node ./test/fca.test.cjs && node ./test/signal-key-store.test.cjs && node ./test/e2ee-device-registration.test.cjs && node ./test/session-validation.test.cjs && node ./test/reconnect-recovery.test.cjs && node ./test/api-parity.test.cjs && node ./test/auto-receipts.test.cjs && node ./test/e2ee-runtime.test.cjs && node ./test/e2ee-peer-manager.test.cjs && node ./test/e2ee-group-key-manager.test.cjs && node ./test/e2ee-group-media.test.cjs && node ./test/e2ee-actions.test.cjs && node ./test/humanizer.test.cjs && node ./test/middleware.test.cjs && node ./test/scheduler.test.cjs",
    "test:build": "npm test",
    "lint": "eslint .eslintrc.cjs scripts/*.cjs test/*.cjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --out-dir dist --external gradient-string --external form-data && node scripts/cjs-bridge.cjs",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "axios-cookiejar-support": "^5.0.5",
    "bluebird": "^3.7.2",
    "cheerio": "^1.0.0-rc.10",
    "cli-progress": "^3.12.0",
    "duplexify": "^4.1.3",
    "form-data": "^4.0.4",
    "gradient-string": "^3.0.0",
    "https-proxy-agent": "^4.0.0",
    "mqtt": "^4.3.8",
    "ora": "^9.3.0",
    "picocolors": "^1.1.1",
    "sequelize": "^6.37.6",
    "sqlite3": "^6.0.1",
    "totp-generator": "^1.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/duplexify": "^3.6.5",
    "@types/node": "^24.6.1",
    "@types/ws": "^8.18.1",
    "eslint": "^8.50.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octopusworldpro-web/OmegA-FCA-test.git"
  },
  "author": {
    "name": "NirZon",
    "url": "https://github.com/nirzon-islam"
  },
  "contributors": [
    {
      "name": "OmegA Bot maintainers",
      "url": "https://github.com/octopusworldpro-web"
    }
  ],
  "bugs": {
    "url": "https://github.com/octopusworldpro-web/OmegA-FCA-test/issues"
  },
  "homepage": "https://github.com/octopusworldpro-web/OmegA-FCA-test#readme",
  "keywords": [
    "facebook",
    "chat",
    "api",
    "messenger",
    "bot",
    "unofficial",
    "automation",
    "facebook-api",
    "facebook-chat",
    "facebook-messenger",
    "chatbot",
    "nodejs",
    "fca",
    "omega"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
